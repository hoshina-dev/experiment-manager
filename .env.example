DATA_SOURCE_NAME="host=localhost user=postgres password=postgres dbname=expman port=5432 sslmode=disable"
CORS_ORIGINS="*"
OTEL_ENABLED=false
OTEL_SERVICE_NAME=experiment-manager
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Cloudflare R2 storage (required for report generation)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto

# Report background worker
REPORT_WORKER_MAX_THREADS=2
REPORT_WORKER_QUEUE_MAX_SIZE=50
