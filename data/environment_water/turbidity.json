{
  "id": "turbidity",
  "label": "Turbidity Measurement",
  "description": "Measure water clarity using a nephelometric turbidimeter (NTU)",
  "workerForm": {
    "title": "Turbidity Form",
    "description": "Record turbidimeter readings",
    "questions": [
      {
        "id": "sample_id_label",
        "label": "Sample label / collection point",
        "required": true,
        "type": "text"
      },
      {
        "id": "ntu_reading_1",
        "label": "Turbidity reading — replicate 1 (NTU)",
        "required": true,
        "type": "number"
      },
      {
        "id": "ntu_reading_2",
        "label": "Turbidity reading — replicate 2 (NTU)",
        "required": true,
        "type": "number"
      }
    ]
  },
  "calculations": {
    "ntu_avg": "Math.round(100 * (ntu_reading_1 + ntu_reading_2) / 2) / 100",
    "who_limit": "5",
    "exceeds_limit": "ntu_avg > who_limit ? \"EXCEEDS WHO limit\" : \"Within WHO limit\""
  },
  "template": "Turbidity = {{ntu_avg}} NTU — {{exceeds_limit}} (5 NTU)"
}
