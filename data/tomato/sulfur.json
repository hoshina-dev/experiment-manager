{
  "id": "sulfur",
  "label": "Sulfur Content Analysis",
  "description": "Determine total sulfur content by titrimetric method",
  "workerForm": {
    "title": "Sulfur Analysis Form",
    "description": "Record sample mass and titration volumes",
    "questions": [
      {
        "id": "sample_mass",
        "label": "Sample mass (g)",
        "required": true,
        "type": "number"
      },
      {
        "id": "titrant_volume",
        "label": "Volume of titrant used (mL)",
        "required": true,
        "type": "number"
      },
      {
        "id": "blank_volume",
        "label": "Blank titrant volume (mL)",
        "required": true,
        "type": "number"
      },
      {
        "id": "normality",
        "label": "Normality of titrant (N)",
        "required": true,
        "type": "number"
      }
    ]
  },
  "calculations": {
    "net_volume": "titrant_volume - blank_volume",
    "sulfur_pct": "Math.round(10000 * (net_volume * normality * 1.603) / sample_mass) / 100"
  },
  "template": "Sulfur content = {{sulfur_pct}}%"
}
